DATABASE_URL="postgresql://user:password@localhost:5432/barberbook?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret"
NODE_ENV="development"

# SMS provider. Current decision: notifications are in-app only, not SMS —
# leave unset (default) to send nothing over SMS. Set to "mock" to also log
# outgoing messages to the console (real delivery is still Phase 4). OTP codes
# are redacted from the logged line by default — also set SMS_MOCK_REVEAL_CODE
# below if you need to read one off the console to test the reset flow.
# SMS_PROVIDER="mock"
# SMS_MOCK_REVEAL_CODE="true"

# Session cookie Secure flag. Leave unset to default to NODE_ENV === "production".
# Only set to "false" for a production build served over plain HTTP (e.g. testing
# at http://ip:port before a domain + TLS exist) — a Secure cookie is silently
# dropped by the browser on non-HTTPS origins, which breaks login with no visible
# error. Remove this override (or set "true") once real HTTPS is in place.
# COOKIE_SECURE="false"

# Host/IP for `next dev` to accept requests from besides localhost, e.g. when
# testing over the network at http://<vps-ip>:3000 before a domain exists
# (apps/web/next.config.ts).
# DEV_ALLOWED_ORIGIN="203.0.113.10"

# Password for the seeded administrator account (packages/db/prisma/seed.ts).
# Leave unset and `pnpm db:seed` generates a random one-time password and
# prints it once — only used the first time the admin row is created, never
# touches an existing account on re-seed. Set this to pick your own instead.
# ADMIN_SEED_PASSWORD="choose-a-strong-password"

# Phone booking (IVR, docs/# IVR BarberBook.txt) — ימות המשיח (Yemot HaMashiach).
# Required for apps/web/src/app/api/ivr/yemot/[secret]/route.ts to work at
# all; leave unset while that feature isn't in use. Switched from Twilio on
# 2026-08-04 — Twilio doesn't offer Israeli phone numbers at all.
# YEMOT_WEBHOOK_SECRET is a long random string *you* generate — it's the
# [secret] path segment and the only thing standing between "a real phone
# call" and "anyone on the internet POSTing fake ApiCallId/ApiPhone values"
# at that route, since Yemot has no signature mechanism like Twilio's
# (§2 decision #17 of the doc). YEMOT_PHONE_NUMBER is the line/number
# customers dial, used only for an optional ApiDID sanity-check (defense in
# depth, not real security). PUBLIC_BASE_URL is the public HTTPS origin
# Yemot's extension api_link calls back to — an ngrok tunnel for local
# testing, the real domain in production (see §3/§9 of the doc). No
# live-transfer number — a wrong/no input hangs up instead of dialing the
# barber (2026-08-04).
# YEMOT_WEBHOOK_SECRET="generate-a-long-random-string"
# YEMOT_PHONE_NUMBER="0XXXXXXXXX"
# PUBLIC_BASE_URL="https://..."

# Real device/browser push notifications for the admin (Web Push) — a "new
# booking" / "new booking request" / "new cancellation request" alert that
# pops up on the barber's phone or computer even when the app is closed.
# Separate from the always-on in-app notification feed at /admin/notifications.
# Leave unset to disable — nothing breaks, the "הפעלת התראות" button just
# stays hidden. Generate the key pair once with (from the repo root):
#   pnpm --filter @barberbook/web exec web-push generate-vapid-keys
# Paste the "Public Key" below as NEXT_PUBLIC_VAPID_PUBLIC_KEY (also readable
# by the browser, must NOT be secret) and the "Private Key" as
# VAPID_PRIVATE_KEY (a real secret — never commit it, never share it).
# VAPID_SUBJECT identifies you to push services (Google/Mozilla/etc.) if they
# ever need to contact you about your usage — a mailto: address or your site's
# https:// URL, either works.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="paste-the-public-key-here"
# VAPID_PRIVATE_KEY="paste-the-private-key-here"
# VAPID_SUBJECT="mailto:you@example.com"
# apps/worker (appointment-reminder pushes) needs the same three values in its own
# apps/worker/.env when run outside Docker (docker-compose shares this file).

# --- Docker Compose production stack only (docker-compose.yml, docs/DEPLOY.md) ---
# Not used by `pnpm dev`/local `next start` — these back the `postgres` and
# `nginx`/`certbot` services. DATABASE_URL above must point at the `postgres`
# service by its compose hostname, not localhost: postgresql://<user>:<password>@postgres:5432/<db>?schema=public
# (same POSTGRES_USER/PASSWORD/DB as below).
# POSTGRES_USER="barberbook"
# POSTGRES_PASSWORD="replace-with-a-long-random-secret"
# POSTGRES_DB="barberbook"
# Real domain pointed at this server's IP (DNS A record) — used by nginx for
# both the server_name and the Let's Encrypt certificate path.
# DOMAIN="booking.example.co.il"

# --- Customer sign-in with an SMS code (docs/SMS-LOGIN.md) — OFF by default ---
# Turns on only when CUSTOMER_LOGIN_MODE="sms_code" AND SMS_PROVIDER is "019" or "mock".
# Read at request time (no rebuild needed, just restart). The administrator always keeps
# password login at /login/admin. Leave all of this unset to keep phone + password login.
# CUSTOMER_LOGIN_MODE="sms_code"
# SMS_PROVIDER="019"                      # "mock" = log only (add SMS_MOCK_REVEAL_CODE="true" to see codes in the log)
# SMS_019_USERNAME="your-019sms-username"
# SMS_019_TOKEN="your-019sms-api-token"    # a real secret — never commit it
# SMS_SENDER_ID="BarberBook"               # max 11 chars, digits/English letters; the provider may need to approve it
# SMS_019_ENDPOINT="https://019sms.co.il/api/test"   # dry-run endpoint; remove for real sending
# Note: SMS_PROVIDER only affects login codes. Notifications (cancellations, reminders, waitlist)
# stay in-app/push — see getSmsProvider() vs getOtpSmsProvider() in packages/shared/src/sms.ts.

