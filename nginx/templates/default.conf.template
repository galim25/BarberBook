# Rendered to /etc/nginx/conf.d/default.conf on container start via nginx:alpine's
# built-in envsubst-on-templates entrypoint script (only $DOMAIN is substituted —
# see docker-compose.yml's nginx service `environment:`).
#
# Bootstrap note (first deploy only, see docs/DEPLOY.md "שלב 2"): this file
# references a certificate at /etc/letsencrypt/live/$DOMAIN/ that doesn't exist
# yet on a brand-new server. Nginx will refuse to start until either a real
# certbot-issued cert or a temporary self-signed dummy one is in place at that
# path — DEPLOY.md walks through creating the dummy cert, starting nginx,
# issuing the real cert via the :80 ACME block below, then reloading.

server {
    listen 80;
    server_name $DOMAIN;

    # certbot's webroot plugin drops its challenge token here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name $DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # Baseline security headers (security/INFRA-SECURITY-FINDINGS.md flagged
    # these as missing back when there was no proxy at all to set them on).
    # Content-Security-Policy is deliberately NOT set yet — Next.js's App
    # Router inline hydration scripts need either 'unsafe-inline' or a
    # nonce-based CSP wired through next.config.ts/middleware, and shipping
    # an untested CSP risks silently breaking the app in production. Add one
    # deliberately, tested against a real build, as a follow-up.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 5m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Next.js dev/HMR websocket isn't used in production, but this keeps
        # any future Upgrade-based connection (SSE, ws) working through the proxy.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
