// Prisma schema for BarberBook — direct translation of docs/# ERD BarberBook.txt
// Field names intentionally mirror the ERD (snake_case) for 1:1 traceability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  administrator
}

enum AttendeeType {
  self
  child
  other
}

enum AppointmentStatus {
  scheduled
  cancelled
}

enum CancellationStatus {
  pending
  approved
  rejected
}

enum BookingRequestStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  appointment_reminder
  appointment_changed
  cancellation_decision
  appointment_booked
  waitlist_slot_available
  booking_decision
  booking_request_pending
  cancellation_request_pending
  customer_registered
}

enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id             String   @id @default(cuid())
  full_name      String
  phone_number   String   @unique
  password_hash  String
  role           UserRole @default(customer)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  password_reset_codes         PasswordResetCode[]
  appointments_booked          Appointment[]         @relation("AppointmentBookedBy")
  cancellation_requests_made   CancellationRequest[]  @relation("CancellationRequestedBy")
  cancellation_requests_review CancellationRequest[]  @relation("CancellationReviewedBy")
  booking_requests_reviewed    BookingRequest[]
  notifications                Notification[]
  announcements_published      Announcement[]
  blocked_phone_numbers        BlockedPhoneNumber[]
  waitlist_entry               WaitlistEntry?
  push_subscriptions           PushSubscription[]

  @@map("users")
}

model BlockedPhoneNumber {
  id                  String   @id @default(cuid())
  phone_number        String   @unique
  blocked_by_user_id  String
  reason              String?
  created_at          DateTime @default(now())

  blocked_by User @relation(fields: [blocked_by_user_id], references: [id], onDelete: Restrict)

  @@map("blocked_phone_numbers")
}

model PasswordResetCode {
  id           String    @id @default(cuid())
  user_id      String
  code         String
  expires_at   DateTime
  verified_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_codes")
}

model Service {
  id                String   @id @default(cuid())
  name              String   @unique
  duration_minutes  Int
  is_child_service  Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  appointments Appointment[]

  @@map("services")
}

model Barber {
  id         String   @id @default(cuid())
  full_name  String
  /// Exactly one Barber has this set — the shop's original single admin
  /// identity (see CLAUDE.md, "שם מנהל המערכת"). Offers all Services; a
  /// sub-barber (is_primary: false) is restricted to a fixed subset (see
  /// SUB_BARBER_SERVICE_NAMES in packages/shared). Can never be deactivated
  /// (setBarberActiveAction rejects it) so the shop always has at least one
  /// bookable barber.
  is_primary Boolean  @default(false)
  /// Deactivating (not deleting — WorkDay.barber_id is onDelete: Restrict)
  /// hides a barber from customer-facing pickers while preserving their
  /// existing calendar/appointments for the admin to still manage.
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  work_days WorkDay[]

  @@map("barbers")
}

model WorkDay {
  id          String   @id @default(cuid())
  barber_id   String
  work_date   DateTime @db.Date
  starts_at   DateTime
  ends_at     DateTime
  /// Blocks the whole day from new customer self-service bookings/reschedules
  /// (getOpenDates excludes it, bookAppointmentAction/rescheduleAppointmentAction
  /// reject it) without touching anything already scheduled — distinct from
  /// BlockedTime (a specific hour range within an otherwise-bookable day) and
  /// from deleting the day (hard delete, irreversible). The admin's own manual
  /// appointment creation is unaffected — this only blocks customer self-service.
  is_blocked  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  barber        Barber        @relation(fields: [barber_id], references: [id], onDelete: Restrict)
  breaks        WorkBreak[]
  blocked_times BlockedTime[]
  appointments  Appointment[]

  @@unique([barber_id, work_date])
  @@map("work_days")
}

model WorkBreak {
  id           String   @id @default(cuid())
  work_day_id  String
  starts_at    DateTime
  ends_at      DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_day WorkDay @relation(fields: [work_day_id], references: [id], onDelete: Cascade)

  @@index([work_day_id])
  @@map("work_breaks")
}

model BlockedTime {
  id           String   @id @default(cuid())
  work_day_id  String
  starts_at    DateTime
  ends_at      DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_day WorkDay @relation(fields: [work_day_id], references: [id], onDelete: Cascade)

  @@index([work_day_id])
  @@map("blocked_times")
}

model Appointment {
  id                  String            @id @default(cuid())
  work_day_id         String
  service_id          String
  booked_by_user_id   String?
  customer_name       String
  attendee_name       String
  attendee_type       AttendeeType
  starts_at           DateTime
  ends_at             DateTime
  status              AppointmentStatus @default(scheduled)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  work_day             WorkDay              @relation(fields: [work_day_id], references: [id], onDelete: Cascade)
  service              Service              @relation(fields: [service_id], references: [id], onDelete: Restrict)
  booked_by            User?                @relation("AppointmentBookedBy", fields: [booked_by_user_id], references: [id], onDelete: SetNull)
  cancellation_request CancellationRequest?
  booking_request      BookingRequest?
  notifications        Notification[]

  @@index([work_day_id])
  @@index([service_id])
  @@index([booked_by_user_id])
  @@map("appointments")
}

model CancellationRequest {
  id                    String              @id @default(cuid())
  appointment_id        String              @unique
  requested_by_user_id  String
  reviewed_by_user_id   String?
  status                CancellationStatus  @default(pending)
  requested_at          DateTime            @default(now())
  reviewed_at           DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  appointment   Appointment    @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  requested_by  User           @relation("CancellationRequestedBy", fields: [requested_by_user_id], references: [id], onDelete: Restrict)
  reviewed_by   User?          @relation("CancellationReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([requested_by_user_id])
  @@map("cancellation_requests")
}

model BookingRequest {
  id                    String               @id @default(cuid())
  appointment_id        String               @unique
  status                BookingRequestStatus @default(pending)
  requested_at          DateTime             @default(now())
  reviewed_by_user_id   String?
  reviewed_at           DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  appointment  Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  reviewed_by  User?       @relation(fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)

  @@map("booking_requests")
}

model Notification {
  id                        String              @id @default(cuid())
  user_id                   String
  appointment_id            String?
  cancellation_request_id   String?
  type                      NotificationType
  content                   String
  status                    NotificationStatus  @default(pending)
  scheduled_at              DateTime?
  sent_at                   DateTime?
  read_at                   DateTime?
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appointment           Appointment?          @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  cancellation_request  CancellationRequest?  @relation(fields: [cancellation_request_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status, scheduled_at])
  @@map("notifications")
}

/**
 * One row per browser/device that opted into real Web Push notifications
 * (Notification/PushManager APIs) — distinct from Notification above, which
 * is only the in-app badge/feed. An administrator can have several rows
 * (e.g. phone + desktop). endpoint is unique per browser install, so
 * re-subscribing the same device upserts instead of duplicating.
 */
model PushSubscription {
  id         String   @id @default(cuid())
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

/**
 * Single global row (id fixed to "singleton", see settings.ts's get-or-create
 * helper — always the only guaranteed way there's exactly one row) that
 * decides whether new customer bookings/cancellations need the barber's
 * explicit approval, or happen instantly. Not per-day, per US request.
 */
model AppSettings {
  id                 String   @id @default("singleton")
  requires_approval  Boolean  @default(false)
  ivr_enabled        Boolean  @default(true)
  updated_at         DateTime @updatedAt

  @@map("app_settings")
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  user_id       String   @unique
  customer_name String
  phone_number  String
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("waitlist_entries")
}

model Announcement {
  id                     String   @id @default(cuid())
  published_by_user_id   String
  title                  String
  content                String
  published_at           DateTime @default(now())
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  published_by User @relation(fields: [published_by_user_id], references: [id], onDelete: Restrict)

  @@map("announcements")
}
